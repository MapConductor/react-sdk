{
  "name": "@mapconductor/reactnative-for-template",
  "version": "0.2.0",
  "private": true,
  "description": "Runnable reference bridge for the MapConductor React Native SDK - copy this to expose an existing native driver to React Native.",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "android",
    "ios",
    "MapConductorReactForTemplate.podspec",
    "react-native.config.js",
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts",
    "dev": "tsup src/index.ts --format cjs,esm --watch",
    "clean": "rm -rf dist",
    "test": "echo 'No tests yet'"
  },
  "keywords": [
    "maps",
    "template",
    "react-native",
    "typescript"
  ],
  "author": "MapConductor",
  "license": "Apache-2.0",
  "peerDependencies": {
    "@mapconductor/js-sdk-core": "^0.2.0",
    "react": "^19.2.0",
    "react-native": ">=0.73.0"
  },
  "dependencies": {
    "@mapconductor/js-sdk-core": "^0.2.0",
    "@mapconductor/js-sdk-react": "^0.2.0",
    "@mapconductor/react-for-template": "^0.2.0"
  },
  "devDependencies": {
    "react": "^19.2.8",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3"
  }
}
