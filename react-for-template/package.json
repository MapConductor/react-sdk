{
  "name": "@mapconductor/react-for-template",
  "version": "0.1.3",
  "private": true,
  "description": "Runnable reference driver for the MapConductor React SDK — copy this to start a new map provider",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": ["dist", "README.md"],
  "scripts": {
    "build": "tsup src/index.tsx --format cjs,esm --dts",
    "clean": "rm -rf dist",
    "test": "node --test \"test/**/*.test.mjs\""
  },
  "author": "MapConductor",
  "license": "Apache2",
  "peerDependencies": {
    "@mapconductor/js-sdk-core": "^0.1.3",
    "react": "^18.0.0 || ^19.0.0"
  },
  "dependencies": {
    "@mapconductor/js-sdk-core": "^0.1.3"
  },
  "devDependencies": {
    "react": "^19.2.7",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3"
  }
}
